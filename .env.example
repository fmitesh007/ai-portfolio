# Offline by default. Switch providers without changing application code.
LLM_PROVIDER=mock            # mock | gemini | openai
EMBEDDING_PROVIDER=local     # local | gemini | openai

# Gemini (only when LLM_PROVIDER=gemini or EMBEDDING_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# OpenAI-compatible (OpenAI, Ollama, vLLM, Together, ...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Storage
DATA_DIR=./data
REQUEST_TIMEOUT=30
